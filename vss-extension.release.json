{
  "$schema": "https://json.schemastore.org/vss-extension",
  "manifestVersion": 1,
  "id": "child-generator",
  "name": "Child Item Generator",
  "version": "0.1.0",
  "publisher": "xerillio",
  "public": true,
  "description": "Generate child work items from configurable templates defined in project settings.",
  "categories": [
    "Azure Boards"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "files": [
    {
      "path": "project-settings.html",
      "addressable": true
    },
    {
      "path": "work-item-menu.html",
      "addressable": true
    },
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "project-settings",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-web.project-admin-hub-group"
      ],
      "properties": {
        "name": "Child Item Generator",
        "uri": "project-settings.html"
      }
    },
    {
      "id": "generate-child-items-menu",
      "type": "ms.vss-web.action",
      "targets": [
        "ms.vss-work-web.work-item-context-menu"
      ],
      "properties": {
        "text": "Generate child items",
        "title": "Generate child items",
        "uri": "work-item-menu.html"
      }
    }
  ]
}
