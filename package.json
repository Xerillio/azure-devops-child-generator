{
  "name": "azure-devops-child-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Azure DevOps extension to generate child items from configurable work item templates.",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testResultsProcessor=jest-sonar-reporter",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "npm run build && tfx extension create --manifests vss-extension.release.json",
    "package:dev": "tfx extension create --manifests vss-extension.dev.json",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "azure-devops-extension-sdk": "^5.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "rimraf": "^6.1.3",
    "tfx-cli": "^0.24.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "jestSonar": {
    "reportPath": "coverage"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
